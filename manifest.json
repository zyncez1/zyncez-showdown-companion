{
  "manifest_version": 3,
  "name": "Zyncez AI Battle Companion",
  "version": "0.16.0",
  "description": "Minimal draggable Showdown messenger with instant offline model switcher, contextual settings and integrated battle analysis.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://play.pokemonshowdown.com/*",
    "https://pokemonshowdown.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://play.pokemonshowdown.com/*",
        "https://pokemonshowdown.com/*"
      ],
      "js": [
        "src/types.js",
        "src/battle-state.js",
        "src/speed.js",
        "vendor/smogon-calc/data.min.js",
        "vendor/smogon-calc/calc.min.js",
        "src/damage-engine.js",
        "src/justification-engine.js",
        "src/decision-engine.js",
        "src/reader.js",
        "src/coach.js",
        "src/message-format.js",
        "src/model-catalog.js",
        "src/chat-ui.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zyncez AI – OpenRouter Settings",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
